<?php namespace ProcessWire;

/**
 * Pageimage Source
 *
 * #pw-summary Extends Pageimage with a srcset property/method plus additional rendering options.
 *
 * @copyright 2026 NB Communication Ltd
 * @license Mozilla Public License v2.0 http://mozilla.org/MPL/2.0/
 *
 * @property string $defaultSets
 * @property bool $allSets
 * @property bool $webp
 * @property int $webpQuality
 * @property bool $useLazy
 * @property bool $usePicture
 * @property bool $removeVariations
 *
 */

class PageimageSource extends WireData implements Module, ConfigurableModule {

	/**
	 * getModuleInfo is a module required by all modules to tell ProcessWire about them
	 *
	 * @return array
	 *
	 */
	public static function getModuleInfo() {
		return [
			'title' => 'Pageimage Source',
			'version' => 120,
			'summary' => 'Extends Pageimage with a srcset property/method and additional rendering options.',
			'author' => 'nbcommunication',
			'href' => 'https://github.com/nbcommunication/PageimageSource',
			'singular' => true,
			'autoload' => 'template!=admin',
			'icon' => 'picture-o',
			'requires' => 'ProcessWire>=3.0.165,PHP>=7.3',
		];
	}

	/**
	 * Appended to the name of the images generated by this module
	 *
	 * Used to remove old variations.
	 *
	 * @var string
	 *
	 */
	const suffix = 'srcset';

	/**
	 * An array of `srcset` widths
	 *
	 * @var array
	 *
	 */
	protected $srcset = [];

	/**
	 * Initialize the module
	 *
	 */
	public function init() {

		// Get and set image srcset widths
		if($this->defaultSets) {
			$this->srcset = $this->getSrcset();
		}

		// If module config loaded
		if((string) $this->wire()->process === 'ProcessModule') {

			$input = $this->wire()->input;

			if(!$this->defaultSets && !$input->post->textarea('defaultSets') && !$input->post->bool('uninstall')) {
				$this->error($this->_('Please enter a srcset configuration.'));
				return;
			}

			if($input->post->bool('removeVariations')) {
				// Remove srcset variations if requested
				$count = $this->removeVariations();
				$input->post->removeVariations = 0;
				if($count) $this->message(sprintf($this->_('%d variations removed'), $count));
			}
		}

		// Pageimage::srcset
		$hookMethods = implode(',', [
			'Pageimage::srcset',
			'Pageimage::httpSrcset',
			'Pageimage::SRCSET',
			'Pageimage::HTTPSRCSET',
		]);
		$this->addHook($hookMethods, $this, 'getImageSrcset');
		$this->addHookProperty($hookMethods, $this, 'getImageSrcset');

		// Pageimage::render
		$this->addHookAfter('Pageimage::render', $this, 'render');
	}

	/**
	 * Generate srcset images and return its attribute string
	 *
	 * `$pageimage->srcset()` accepts two arguments:
	 * - `srcset` (string|array): The srcset configuration.
	 * - `options` (array): Options to modify default sizing behaviour.
	 * For more information visit https://processwire.com/api/ref/pageimage/size/.
	 *
	 * #pw-hooker
	 * #pw-hookable
	 *
	 * @param HookEvent $event
	 * @return string
	 *
	 */
	public function ___getImageSrcset(HookEvent $event) {

		$sanitizer = $this->wire()->sanitizer;

		$image = $event->object;
		$srcset = $event->arguments(0);
		$options = $event->arguments(1);

		// Handle shortcuts
		if(!is_array($srcset) && !is_string($srcset)) $srcset = $this->srcset;
		if(!is_array($options)) $options = [];

		// Allow an explicit 'webp' option to override the module's $this->webp setting
		// for this call only (used by Pageimage::render()'s <picture> markup, which
		// needs to request both webp and non-webp variants of the same srcset without
		// mutating any shared module state).
		$webp = array_key_exists('webp', $options) ? (bool) $options['webp'] : (bool) $this->webp;
		unset($options['webp']);

		$property = [
			'srcset' => $webp ? 'webpUrl' : 'url',
			'httpSrcset' => 'httpUrl',
			'SRCSET' => 'URL',
			'HTTPSRCSET' => 'HTTPURL',
		][$event->method];

		// Get srcset config
		$srcset = $this->getSrcset($srcset);

		// Set default size options
		$options = array_merge([
			'allSets' => (bool) $this->allSets,
			'suffix' => self::suffix,
			'upscaling' => false,
			'webpAdd' => $webp,
		], $options);

		if($this->webpQuality && !isset($options['webpQuality'])) {
			$options['webpQuality'] = $this->webpQuality;
		}

		if($options['allSets']) {
			$options['upscaling'] = true;
		}

		// Image Parameters
		$imageWidth = $image->width;
		$imageHeight = $image->height;
		$ratio = $imageWidth && $imageHeight ? $imageWidth / $imageHeight : 1;

		// Handle image variations
		$variation = $image->isVariation($image->basename, ['allowSelf' => true]);
		if($variation) {
			// Image is a variation, get original and variant dimensions
			$image = $image->getOriginal();
			$imageWidth = $variation['width'];
			$imageHeight = $variation['height'];
		}

		$sets = [];
		$break = false;
		foreach($srcset as $rule => $dimensions) {

			$cropWidth = $sanitizer->int($dimensions[0]);
			$cropHeight = $sanitizer->int($dimensions[1] ?? 0);

			$resolved = $this->resolveSetImage($event, $image, $imageWidth, $imageHeight, $ratio, $variation, $options, $cropWidth, $cropHeight);
			$img = $resolved['image'];
			if($resolved['break']) $break = true;

			if(is_null($img)) {

				$img = $event->object;
				// Use the original image but apply options
				$img = $img->size($img->width, $img->height, $options);
				// No need for more sets
				$break = !$cropHeight;
				if($break && substr($rule, -1) === 'w') {
					// If terminating the set rules
					// set the descriptive width as the actual width of the image
					$rule = "{$img->width}w";
				}
			}

			// Add set
			if(!isset($sets[$rule])) $sets[$rule] = "{$img->$property} $rule";
			if($break && !$options['allSets']) break;
		}

		$event->return = count($sets) ? implode(', ', $sets) : '';
	}


	/**
	 * Return a srcset config array
	 *
	 * Public varsion of getSrcset() / $srcset
	 * primarily for use in the config module.
	 *
	 * #pw-internal
	 *
	 * @param array|string $sets
	 * @return array
	 *
	 */
	public function getSets($sets = null) {
		return isset($sets) ? $this->getSrcset($sets) : $this->srcset;
	}

	/**
	 * Extend Pageimage::render
	 *
	 * #pw-hooker
	 * #pw-hookable
	 *
	 * @param HookEvent $event
	 * @return string
	 * @see Pageimage::render()
	 *
	 */
	public function render(HookEvent $event) {

		$config = $this->wire()->config;

		$image = $event->object;
		$img = $event->return;
		$markup = $event->arguments(0);
		$options = $event->arguments(1);
		if(is_null($options) && !is_string($markup)) $options = $markup;
		if($options === false) {
			// Disable augmentation for this call only.
			// $event->return already holds the unmodified core render() output,
			// so just return without mutating shared module state (which would
			// otherwise leak into every image rendered later in the same request).
			return;
		}
		if(!is_array($options)) $options = [];

		// Set default options and return
		$options = array_merge([
			'srcset' => true,
			'sizes' => '100vw',
			'lazy' => $this->useLazy,
			'picture' => $this->usePicture,
			'useSrcUrlOnSize' => false,
		], $options);

		// Use a local $useWebp flag rather than mutating the shared $this->webp module
		// property for the duration of this call - previously this method saved/restored
		// $this->webp in three separate places (here, inside the $_getSrcset closure, and
		// at the end of the method), which was fragile and easy to break during a future
		// edit. getImageSrcset() now accepts an explicit 'webp' option override so no
		// module state needs to be mutated at all.
		$useWebp = (bool) $this->webp;
		if(!in_array($image->ext, ['jpeg', 'jpg', 'png'])) $useWebp = false;

		if($useWebp && $this->webpQuality) {
			$config->webpOptions('quality', $this->webpQuality);
		}

		if($options['useSrcUrlOnSize'] && strpos($image->webp()->url, '.webp') === false) $useWebp = false;

		if(is_array($options['sizes'])) {
			$options['sizes'] = implode(', ', $options['sizes']);
		}

		if(!$useWebp) $options['picture'] = false;
		if($options['lazy']) $options['lazy'] = 'lazy';

		// Get resized image if width/height passed in options
		if(!empty($options['width']) || !empty($options['height'])) {
			$w = $options['width'] ?? 0;
			$h = $options['height'] ?? 0;
			$image = $image->size((int) $w, (int) $h, $options);
		}

		$attributes = [];
		$replacements = [];

		$apos = strpos($img, '"') === false ? "'" : '"';

		$_isAttr = function($a) {
			return !empty($a) && is_string($a);
		};

		$_hasAttr = function($a) use ($img) {
			return strpos($img, "$a=") !== false;
		};

		$_getSrcset = function($webp = null) use ($config, $image, $options, $useWebp) {
			// Resolve the webp flag for this call: an explicit true/false argument
			// (used by the <picture> branch below to force each <source>) takes
			// precedence, otherwise fall back to the locally-resolved $useWebp.
			// This is passed through explicitly as a 'webp' srcset option rather
			// than temporarily mutating $this->webp on the module instance.
			$effectiveWebp = is_bool($webp) ? $webp : $useWebp;
			$webpOptions = $config->webpOptions();
			if(is_bool($webp)) {
				$config->webpOptions([
					'useSrcUrlOnSize' => false,
					'useSrcUrlOnFail' => false,
				]);
			}
			$srcset = '';
			if($options['srcset'] !== false) {
				if(is_array($options['srcset']) && $this->isArrayAssociative($options['srcset'])) {
					$rules = $options['srcset']['rules'] ?? null;
					$srcsetOptions = $options['srcset']['options'] ?? [];
				} else {
					$rules = $options['srcset'];
					$srcsetOptions = [];
				}
				$srcsetOptions['webp'] = $effectiveWebp;
				$srcset = $image->srcset($rules, $srcsetOptions);
			}
			$config->webpOptions($webpOptions);
			return $srcset;
		};

		if(!$options['picture']) {

			// srcset
			$srcset = $_getSrcset();
			if($_hasAttr('srcset')) {
				$replacements['srcset'] = $srcset;
			} else if($_isAttr($srcset)) {
				$attributes[] = "srcset=$apos{$srcset}$apos";
			}

			// sizes
			if($_hasAttr('sizes')) {
				$replacements['sizes'] = $options['sizes'];
			} else if($_isAttr($options['sizes']) && $srcset) {
				$attributes[] = "sizes=$apos{$options['sizes']}$apos";
			}
		}

		// lazy loading
		if($_hasAttr('loading')) {
			$replacements['loading'] = $options['lazy'] ?: '';
		} else if($_isAttr($options['lazy'])) {
			$attributes[] = "loading=$apos{$options['lazy']}$apos";
		}

		// Add attributes
		if(count($attributes)) {
			$img = rtrim($img, ' />') . ' ' . implode(' ', $attributes) . '>';
		}

		// Replace tags
		if(count($replacements)) {
			$img = str_replace(array_map(function($tag) {
				return '{' . $tag . '}';
			}, array_keys($replacements)), array_values($replacements), $img);
		}

		if($options['picture']) {

			$attrsWebp = '';
			$attrs = '';
			if($options['srcset']) {
				$attrsWebp = 'srcset="' . $_getSrcset(true) . '" sizes="' . $options['sizes'] . '"';
				$attrs = 'srcset="' . $_getSrcset(false) . '" sizes="' . $options['sizes'] . '"';
			} else {
				$attrsWebp = 'srcset="' . $image->webpUrl . '"';
				$attrs = 'srcset="' . $image->url . '"';
			}

			$img = (is_string($options['picture']) && substr($options['picture'], 0, 8) === '<picture' ?
				$options['picture'] :
				'<picture>'
			) .
				'<source ' . $attrsWebp . ' type="image/webp">' .
				'<source ' . $attrs . ' type="image/' .($image->ext === 'jpg' ? 'jpeg' : $image->ext) . '">' .
			"{$img}</picture>";

		} else if($useWebp) {

			$img = str_replace($image->url, $image->webpUrl, $img);
		}

		// Render additional attributes
		$event->return = $img;
	}

	/**
	 * Return the srcset config array
	 *
	 * #pw-internal
	 *
	 * @param array|string $sets
	 * @return array
	 *
	 */
	protected function getSrcset($sets = null) {

		if(is_array($sets)) {
			// No rule checking performed
			if($this->isArrayAssociative($sets)) return $sets;
		} else {
			// Parse string to get sets ready for checking
			$sets = explode("\n", str_replace(',', "\n", (is_string($sets) ? $sets : $this->defaultSets)));
		}

		$input = $this->wire()->input;
		$sanitizer = $this->wire()->sanitizer;

		$srcset = [];
		$errors = [];
		$validCount = 0;
		foreach($sets as $line) {

			$line = trim($line);
			if(empty($line)) continue;

			$parts = explode(' ', $line);
			if(count($parts) > 2) {
				// Too many parts in the rule
				$errors[] = $line;
				continue;
			}

			$size = strtolower($parts[0]);
			$rule = count($parts) === 2 ? strtolower($parts[1]) : null;
			if(isset($rule) && (strpos($rule, 'w') === false && strpos($rule, 'x') === false)) {
				// Invalid Rule
				$errors[] = $line;
				continue;
			}

			$dimensions = explode('x', $size);
			if(empty($size) || count($dimensions) > 2) {
				// Too many or not enough dimensions
				$errors[] = $line;
				continue;
			}

			// Sanitize width/height as integers
			foreach($dimensions as $key => $value) {
				$int = $sanitizer->int($value);
				if(strlen($int) !== strlen($value)) {
					$errors[] = $line;
					continue 2;
				}
				$dimensions[$key] = $int;
			}

			$width = $dimensions[0];
			$height = count($dimensions) === 2 ? $dimensions[1] : 0;

			if(!($width + $height)) {
				// Both dimensions are zero
				$errors[] = $line;
				continue;
			}

			$validCount++;
			$srcset[$rule ?? ($width ?: $height) . 'w'] = [$width, $height];
		}

		if(count($errors)) {
			// Do not display errors when set rules are initially edited in the module config
			// (compare posted lines vs a non-deduplicated count of successfully parsed lines,
			// NOT count($srcset) - $srcset is keyed/deduplicated by rule, so duplicate valid
			// rules would otherwise mask a genuinely invalid line, e.g. "320", "320", "bogus"
			// produces 3 posted lines but only 1 unique srcset entry. Must use the textarea
			// sanitizer and an array, since count() on the raw string value fatals on PHP8)
			$postedDefaultSets = $input->post->textarea('defaultSets');
			$postedLines = $postedDefaultSets ?
				array_filter(array_map('trim', explode("\n", str_replace(',', "\n", $postedDefaultSets)))) :
				[];
			if(!(count($postedLines) && count($postedLines) !== $validCount)) {
				foreach($errors as $error) {
					$this->error(sprintf($this->_('%s is not a valid set rule.'), $error));
				}
			}
		}

		return $srcset;
	}

	/**
	 * Check if an array is associative or sequential
	 *
	 * #pw-internal
	 *
	 * @param array $array The array to evaluate.
	 * @return bool
	 *
	 */
	private function isArrayAssociative(array $array) {
		if(array() === $array) return false;
		return array_keys($array) !== range(0, count($array) - 1);
	}

	/**
	 * Remove all srcset variation files generated by this module
	 *
	 * Recursive so this also works when $config->pagefileExtendedPaths is enabled
	 * (nested subdirectories). Used both by the "Remove Variations" module config
	 * checkbox and automatically on module uninstall, so generated variations don't
	 * accumulate as orphaned files once the module is no longer generating/using them.
	 *
	 * #pw-internal
	 *
	 * @return int Number of files removed
	 *
	 */
	protected function removeVariations() {
		$count = 0;
		$filesPath = $this->wire()->config->paths->files;
		if(is_dir($filesPath)) {
			$rii = new \RecursiveIteratorIterator(
				new \RecursiveDirectoryIterator($filesPath, \FilesystemIterator::SKIP_DOTS)
			);
			foreach($rii as $file) {
				if(!$file->isFile()) continue;
				if(strpos($file->getFilename(), '-' . self::suffix . '.') !== false) {
					$count++;
					$this->wire()->files->unlink($file->getPathname());
				}
			}
		}
		return $count;
	}

	/**
	 * Resolve the appropriately sized image for a single srcset rule
	 *
	 * Extracted from ___getImageSrcset() to isolate the per-rule sizing decision, which
	 * involves several interacting conditions (upscaling, image variations, width vs
	 * height driven crops). This is a refactor only - behaviour is unchanged from the
	 * original inline implementation, including the loop-control side effect described
	 * in the $break return value below.
	 *
	 * #pw-internal
	 *
	 * @param HookEvent $event The srcset hook event (used for its ->object fallback)
	 * @param Pageimage $image The source image (the original, if $variation is set)
	 * @param int $imageWidth Width to size from (variation width, if applicable)
	 * @param int $imageHeight Height to size from (variation height, if applicable)
	 * @param float $ratio Width/height ratio of $imageWidth/$imageHeight
	 * @param array|bool $variation Result of Pageimage::isVariation(), or false
	 * @param array $options Size options to pass through to size()/height()
	 * @param int $cropWidth Requested width for this rule (may be reduced if upscaling is disabled)
	 * @param int $cropHeight Requested height for this rule (may be reduced if upscaling is disabled)
	 * @return array [
	 *   'image' => Pageimage|null Resized image, or null if the caller should fall back
	 *     to the original image resized with $options applied,
	 *   'break' => bool|null Whether the calling loop's $break flag should be forced true
	 *     (only ever true for the case where the image has a height but no width, and the
	 *     requested crop exceeds the available height); null means no change to $break.
	 * ]
	 *
	 */
	protected function resolveSetImage(HookEvent $event, Pageimage $image, $imageWidth, $imageHeight, $ratio, $variation, array $options, $cropWidth, $cropHeight) {

		$img = null;
		$break = null;

		if(($cropWidth || $cropHeight) && (($cropWidth && $imageWidth > $cropWidth) || ($cropHeight && $imageHeight > $cropHeight))) {

			if(!$options['upscaling']) {
				if($imageWidth && $cropWidth > $imageWidth) {
					$cropWidth = $imageWidth;
				}
				if($imageHeight && $cropHeight > $imageHeight) {
					$cropHeight = $imageHeight;
				}
			}

			if($variation && (!$cropWidth || !$cropHeight)) {

				$ratioHeight = round($cropWidth / $ratio);
				if($imageHeight && $ratioHeight > $imageHeight) {
					$ratioHeight = $imageHeight;
				}

				if($imageWidth && $imageHeight) {

					if(!$cropWidth) {
						$cropWidth = $cropHeight;
						$cropHeight = round($cropHeight / $ratio);
					}

					if($imageWidth > $cropWidth) {
						$img = $image->size($cropWidth, $cropHeight ?: $ratioHeight, $options);
					} else {
						$img = $event->object;
					}

				} else if($imageHeight && !$imageWidth) {

					if($imageHeight > $cropHeight && $imageHeight > $cropWidth) {
						$img = $image->height($cropHeight ?: $cropWidth, $options);
					} else {
						$img = $event->object;
						$break = true;
					}
				}
			}

			if(is_null($img) && (
				($cropWidth && $image->width > $cropWidth) ||
				($cropHeight && $image->height > $cropHeight)
			)) {
				$img = $image->size($cropWidth, $cropHeight, $options);
			}

		} else if($options['allSets'] && $options['upscaling'] && $cropWidth && $cropHeight) {

			$img = $image->size($cropWidth, $cropHeight, $options);

		} else if($cropHeight && $imageHeight > $cropHeight) {

			$img = $image->height($cropHeight, $options);
		}

		return ['image' => $img, 'break' => $break];
	}

	/**
	 * Called when the module is uninstalled
	 *
	 * Removes any srcset variation files this module has generated, so they don't
	 * remain behind as orphaned files once the module is no longer present to
	 * regenerate or manage them.
	 *
	 * #pw-internal
	 *
	 */
	public function ___uninstall() {
		$count = $this->removeVariations();
		if($count) {
			$this->message(sprintf($this->_('%d srcset variations removed'), $count));
		}
	}
}
